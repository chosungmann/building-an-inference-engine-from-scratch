<?xml version="1.0" encoding="utf-8"?>
<!-- badak을 부르는 가장 작은 Android 앱 (44장). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="book.badak.demo"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35" />

    <!-- extractNativeLibs="false": 엔진의 .so를 번들에서 꺼내 복사하지 않고
         번들 안에 든 채로 메모리에 매핑한다. 그러려면 .so가 눌리지 않은 채로,
         페이지의 경계에 맞춰 들어 있어야 한다(build.sh의 zipalign). -->
    <application
        android:label="BadakDemo"
        android:extractNativeLibs="false"
        android:hasCode="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
